# Server-only PostgreSQL connection. Never use a NEXT_PUBLIC_ prefix here.
# In the Railway website service, reference the existing database:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# Locally use the database public URL, if public networking is already enabled.
DATABASE_URL=

# Generate a private one-time owner setup code:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Remove this variable after creating the first owner account.
SETUP_TOKEN=

# Exact website origin (no trailing slash) for same-origin mutation checks.
APP_ORIGIN=http://localhost:3000

# Optional trusted CA certificate; certificate verification is never disabled.
DATABASE_SSL_CA=

# Explicit sample-data preview, which never writes to PostgreSQL.
# Development without DATABASE_URL also enables preview; production does not.
WORKSPACE_PREVIEW=false

# Server-only Railway bucket references (Credentials > Add to Service > AWS SDK).
# AWS_ENDPOINT_URL=${{buffered-tin.ENDPOINT}}
# AWS_S3_BUCKET_NAME=${{buffered-tin.BUCKET}}
# AWS_DEFAULT_REGION=${{buffered-tin.REGION}}
# AWS_ACCESS_KEY_ID=${{buffered-tin.ACCESS_KEY_ID}}
# AWS_SECRET_ACCESS_KEY=${{buffered-tin.SECRET_ACCESS_KEY}}
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
