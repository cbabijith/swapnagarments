{
  "name": "swapna-garments",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22",
    "bun": "1.3.14"
  },
  "description": "Swapna Garments — custom tailoring management (web + backend + mobile monorepo)",
  "workspaces": [
    "web",
    "backend"
  ],
  "scripts": {
    "dev:web": "bun run --cwd web dev",
    "dev:backend": "bun run --cwd backend dev",
    "start:web": "bun run --cwd web start",
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "lint": "bun run --workspaces --if-present lint",
    "test": "bun run --cwd web test",
    "db:push": "bun run --cwd backend db:push"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "fsevents",
    "unrs-resolver"
  ]
}
