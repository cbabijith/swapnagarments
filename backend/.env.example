# --- Application ---
LOG_LEVEL=info
APP_NAME=Swapna Garments
PORT=3001
# Origin of the web app, allowed for CORS + Better Auth trusted origins
WEB_ORIGIN=http://localhost:3000

# --- Auth (Better Auth) ---
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001/auth

# --- Database (SQLite file for auth; domain DB choice is pending workshop) ---
DATABASE_FILE=./data/swapna.db
